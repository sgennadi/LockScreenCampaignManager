<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LockScreenCampaignManager</AssemblyName>
    <RootNamespace>LockScreenCampaignManager</RootNamespace>
    <Version>0.4.0-preview.113</Version>
    <ApplicationIcon>Assets\LockScreen.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\LockScreen.ico" LogicalName="LockScreenCampaignManager.AppIcon" />
    <EmbeddedResource Include="Assets\LockScreen-Agent.ps1" LogicalName="LockScreenCampaignManager.Agent.ps1" />
    <EmbeddedResource Include="Assets\PhotoSaver-StartupInstall.ps1" LogicalName="LockScreenCampaignManager.PhotoSaverStartupInstall.ps1" />
  </ItemGroup>
</Project>
